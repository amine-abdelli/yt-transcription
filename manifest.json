{
  "manifest_version": 3,
  "name": "YouTube Transcript Downloader",
  "version": "1.1.0",
  "description": "Download YouTube transcripts and generate Recap-style inline summaries with per-claim fact-checking",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": [
        "openai-summary.js",
        "recap-api.js",
        "panel.js",
        "content.js",
        "recap-orchestrator.js"
      ],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
